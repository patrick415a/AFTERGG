{
  "name": "aftergg-backend",
  "version": "1.1.0",
  "private": true,
  "description": "Riot API backend adapted from teammate lol-rank-site",
  "main": "server/server.js",
  "scripts": {
    "db:migrate": "node scripts/migrate-db.js",
    "db:check": "node scripts/migrate-db.js --check",
    "db:status": "node scripts/db-status.js",
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "oracledb": "^26.0.0"
  }
}
